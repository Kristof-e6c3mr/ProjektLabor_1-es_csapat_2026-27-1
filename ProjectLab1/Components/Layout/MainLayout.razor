@inherits LayoutComponentBase
@implements IDisposable

@inject NavigationManager Navigation
@inject ProjectLab1.Services.UserSessionService UserSession

<div class="page">
    @if (UserSession.IsLoggedIn && !IsLoginPage)
    {
        <div class="sidebar">
            <NavMenu />
        </div>
    }

    <main>
        @if (UserSession.IsLoggedIn && !IsLoginPage)
        {
            <div class="top-row px-4 justify-content-between align-items-center">
                <div>
                    <span class="fw-bold">Bejelentkezve:</span> @UserSession.Username
                    <span class="badge bg-info text-dark ms-2">@UserSession.Role</span>
                </div>
                <a href="/login" class="btn btn-outline-danger btn-sm text-decoration-none" @onclick="Kijelentkezes">
                    Kijelentkezés
                </a>
            </div>
        }

        <article class="content px-4 py-3">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool IsLoginPage => Navigation.Uri.EndsWith("/login", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        // JAVÍTVA: Saját eseménykezelőt kötünk be, ami kezeli a szálakat
        UserSession.OnChange += HandleSessionChanged;
    }

    private void HandleSessionChanged()
    {
        // JAVÍTVA: InvokeAsync-be csomagoljuk a felületfrissítést, így a UI szálon fut le
        InvokeAsync(StateHasChanged);
    }

    private void Kijelentkezes()
    {
        UserSession.Logout();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        // JAVÍTVA: Leiratkozás az új metódusról
        UserSession.OnChange -= HandleSessionChanged;
    }
}