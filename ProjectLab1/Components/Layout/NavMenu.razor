@inject ProjectLab1.Services.UserSessionService UserSession

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Kulcs & Terem Nyilvántartó</a>
    </div>
</div>

<input type="checkbox" id="navbar-toggler" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.getElementById('navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Kezdőlap
            </NavLink>
        </div>

        @if (UserSession.Role == "Oktato")
        {
            <!-- OKTATÓ: teremfoglalás és saját foglalások -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="foglalasok">
                    <span class="bi bi-calendar-check" aria-hidden="true"></span> Saját foglalásaim
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="pin-lekerdezes">
                    <span class="bi bi-key" aria-hidden="true"></span> Saját PIN kód
                </NavLink>
            </div>
        }

        @if (UserSession.Role == "Portas")
        {
            <!-- PORTÁS: kulcs kiadás/átvétel, hibajegy -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="kulcskiadas">
                    <span class="bi bi-key" aria-hidden="true"></span> Kulcs kiadása
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="hibajegy">
                    <span class="bi bi-exclamation-triangle" aria-hidden="true"></span> Hibajegy felvétele
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="szekreny">
                    <span class="bi bi-grid-3x3-gap" aria-hidden="true"></span> Kulcsszekrény
                </NavLink>
            </div>
        }

        @if (UserSession.Role == "Adminisztrator")
        {
            <!-- ADMINISZTRÁTOR: teremtörzs, kulcstörzs, mesterkulcs jogosultság, karbantartási idősáv, hibajegyek -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="termek">
                    <span class="bi bi-building" aria-hidden="true"></span> Termek kezelése
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="kulcsok">
                    <span class="bi bi-journal-bookmark" aria-hidden="true"></span> Kulcsok kezelése
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="mesterkulcsjogosultsag">
                    <span class="bi bi-shield-lock" aria-hidden="true"></span> Mesterkulcs jogosultságok
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="karbantartas">
                    <span class="bi bi-tools" aria-hidden="true"></span> Karbantartások
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin-hibajegyek">
                    <span class="bi bi-exclamation-triangle" aria-hidden="true"></span> Hibajegyek kezelése
                </NavLink>
            </div> <!-- EZ A ZÁRÓ TAG HIÁNYZOTT -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="felszereltsegek">
                    <span class="bi bi-tools" aria-hidden="true"></span> Felszereltségek
                </NavLink>
            </div>
        }

        @if (UserSession.Role == "UzemeltetesiIgazgato")
        {
            <!-- ÜZEMELTETÉSI IGAZGATÓ: (Riportok / audit log) -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="">
                    <span class="bi bi-graph-up" aria-hidden="true"></span> Riportok & Elemzések
                </NavLink>
            </div>
        }
    </nav>
</div>