@page "/karbantartas"
@rendermode InteractiveServer
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ProjectLab1.Services.UserSessionService UserSession

<PageTitle>Karbantartások kezelése</PageTitle>

<div class="container mt-4">
    <h3>Karbantartások kezelése</h3>
    <hr />

    <!-- ŰRLAP RÉSZ -->
    <div class="card mb-4 shadow-sm border-primary">
        <div class="card-header @(szerkesztettKarbantartasId > 0 ? "bg-warning" : "bg-primary") text-white">
            <h5 class="mb-0">
                @(szerkesztettKarbantartasId > 0 ? "Karbantartás szerkesztése" : "Új karbantartás rögzítése")
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Terem (keresés)</label>
                    <input list="termek-list" class="form-control" @bind="kivalasztottTeremszam" placeholder="Gépelj..." />
                    <datalist id="termek-list">
                        @if (termek != null)
                        {
                            @foreach (var t in termek)
                            {
                                <option value="@t.Teremszam"></option>
                            }
                        }
                    </datalist>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Kezdés (Dátum és idő)</label>
                    <input type="datetime-local" class="form-control" @bind="kezdoIdo" @bind:after="KarbantartasKezdoValtozott" />
                </div>
                <div class="col-md-3">
                    <label class="form-label d-flex justify-content-between">
                        <span>Befejezés</span>
                        <span class="badge bg-info text-dark">Időtartam: @Math.Round((zaroIdo - kezdoIdo).TotalHours, 1) óra</span>
                    </label>
                    <input type="datetime-local" class="form-control" min="@kezdoIdo.ToString("yyyy-MM-ddTHH:mm")" @bind="zaroIdo" @bind:after="KarbantartasZaroValtozott" />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button class="btn btn-primary w-100" @onclick="Ellenorzes">Ütközések ellenőrzése</button>
                    @if (szerkesztettKarbantartasId > 0)
                    {
                        <button class="btn btn-secondary" @onclick="MentesMegsem" title="Mégsem"><i class="bi bi-x-lg"></i></button>
                    }
                </div>
            </div>
            
            <div class="row mt-3">
                <div class="col-md-12">
                    <label class="form-label">Karbantartás leírása</label>
                    <input type="text" class="form-control" @bind="leiras" placeholder="Pl. Festés, klíma javítás..." />
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(hibaUzenet))
    {
        <div class="alert alert-danger">@hibaUzenet</div>
    }
    @if (!string.IsNullOrEmpty(sikeresUzenet))
    {
        <div class="alert alert-success">@sikeresUzenet</div>
    }

    <!-- ÜTKÖZÉSEK LISTÁJA (Mentés előtt) -->
    @if (ellenorzott && utkozesEredmeny != null)
    {
        bool vanUtkozes = utkozesEredmeny.Foglalasok.Any() || utkozesEredmeny.Karbantartasok.Any();

        if (vanUtkozes)
        {
            <div class="alert alert-warning">
                <strong>Figyelem!</strong> A megadott idősávban ütközéseket találtunk: 
                @utkozesEredmeny.Foglalasok.Count db foglalás és @utkozesEredmeny.Karbantartasok.Count db másik karbantartás.
                A rögzítéshez ezeket mind törölnöd vagy áthelyezned kell!
            </div>

            @if (utkozesEredmeny.Foglalasok.Any())
            {
                <h6 class="mt-3 fw-bold">Ütköző Foglalások</h6>
                <table class="table table-bordered align-middle bg-white mb-4">
                    <thead class="table-dark">
                        <tr>
                            <th>Oktató</th>
                            <th>Kezdés</th>
                            <th>Befejezés</th>
                            <th>Műveletek</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in utkozesEredmeny.Foglalasok)
                        {
                            <tr>
                                <td class="fw-bold">@u.OktatoNev</td>
                                <td>@u.KezdoIdo.ToLocalTime().ToString("yyyy.MM.dd HH:mm")</td>
                                <td>@u.ZaroIdo.ToLocalTime().ToString("yyyy.MM.dd HH:mm")</td>
                                <td>
                                    @if (szerkesztettFoglalasId == u.FoglalasID)
                                    {
                                        <div class="d-flex gap-2 align-items-center">
                                            <input list="termek-list" class="form-control form-control-sm w-auto" @bind="ujTeremszam" placeholder="Terem..." />
                                            <input type="date" class="form-control form-control-sm w-auto" @bind="ujDatum" />
                                            <input type="time" class="form-control form-control-sm w-auto" @bind="ujKezdoId" @bind:after="UjKezdoIdoValtozott" />
                                            <span>-</span>
                                            <input type="time" class="form-control form-control-sm w-auto" @bind="ujZaroId" />
                                            
                                            <button class="btn btn-success btn-sm ms-2" @onclick="FoglalasMentes">Mentés</button>
                                            <button class="btn btn-secondary btn-sm" @onclick="() => szerkesztettFoglalasId = 0">Mégsem</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-warning btn-sm me-2" @onclick="() => SzerkesztesMegnyitasa(u)">Áthelyezés</button>
                                        <button class="btn btn-danger btn-sm" @onclick="() => FoglalasTorles(u.FoglalasID)">Törlés</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (utkozesEredmeny.Karbantartasok.Any())
            {
                <h6 class="mt-3 fw-bold text-danger">Ütköző (másik) Karbantartások</h6>
                <table class="table table-bordered align-middle bg-white border-danger mb-4">
                    <thead class="table-danger">
                        <tr>
                            <th>Leírás</th>
                            <th>Kezdés</th>
                            <th>Befejezés</th>
                            <th>Műveletek</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var uk in utkozesEredmeny.Karbantartasok)
                        {
                            <tr>
                                <td class="fw-bold">@uk.Leiras</td>
                                <td>@uk.KezdoIdo.ToLocalTime().ToString("yyyy.MM.dd HH:mm")</td>
                                <td>@uk.ZaroIdo.ToLocalTime().ToString("yyyy.MM.dd HH:mm")</td>
                                <td>
                                    @if (szerkesztettUtkozoKarbId == uk.KarbantartasID)
                                    {
                                        <div class="d-flex gap-2 align-items-center">
                                            <input list="termek-list" class="form-control form-control-sm w-auto" @bind="ujKarbTeremszam" placeholder="Terem..." />
                                            <input type="datetime-local" class="form-control form-control-sm w-auto" @bind="ujKarbKezdo" @bind:after="UjKarbKezdoValtozott" />
                                            <span>-</span>
                                            <input type="datetime-local" class="form-control form-control-sm w-auto" @bind="ujKarbZaro" />
                                            
                                            <button class="btn btn-success btn-sm ms-2" @onclick="() => UtkozoKarbantartasMentes(uk.Leiras)">Mentés</button>
                                            <button class="btn btn-secondary btn-sm" @onclick="() => szerkesztettUtkozoKarbId = 0">Mégsem</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-warning btn-sm me-2" @onclick="() => UtkozoKarbSzerkesztesMegnyitasa(uk)">Áthelyezés</button>
                                        <button class="btn btn-danger btn-sm" @onclick="() => KarbantartasTorles(uk.KarbantartasID)">Törlés</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
        else
        {
            <div class="alert alert-success d-flex justify-content-between align-items-center">
                <span>Az idősáv tiszta, nincsenek ütközések!</span>
                <button class="btn btn-success" @onclick="KarbantartasMentes">Karbantartás mentése</button>
            </div>
        }
    }

    <!-- MEGLÉVŐ KARBANTARTÁSOK LISTÁJA -->
    <h4 class="mt-5">Folyamatban lévő és jövőbeli karbantartások</h4>
    @if (letezoKarbantartasok == null)
    {
        <p><em>Betöltés...</em></p>
    }
    else if (!letezoKarbantartasok.Any())
    {
        <div class="alert alert-info">Jelenleg nincs rögzített karbantartás.</div>
    }
    else
    {
        <table class="table table-striped table-hover align-middle mt-3">
            <thead class="table-light">
                <tr>
                    <th>Terem</th>
                    <th>Leírás</th>
                    <th>Kezdés</th>
                    <th>Befejezés</th>
                    <th>Állapot</th>
                    <th>Műveletek</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in letezoKarbantartasok)
                {
                    <tr>
                        <td class="fw-bold fs-5">@k.Teremszam</td>
                        <td>@k.Leiras</td>
                        <td>@k.KezdoIdo.ToLocalTime().ToString("yyyy.MM.dd HH:mm")</td>
                        <td>@k.ZaroIdo.ToLocalTime().ToString("yyyy.MM.dd HH:mm")</td>
                        <td>
                            @if (k.ZaroIdo.ToLocalTime() < DateTime.Now)
                            {
                                <span class="badge bg-secondary">Lezárult</span>
                            }
                            else if (k.KezdoIdo.ToLocalTime() <= DateTime.Now && k.ZaroIdo.ToLocalTime() >= DateTime.Now)
                            {
                                <span class="badge bg-danger">Folyamatban</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Tervezett</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-warning btn-sm me-2" @onclick="() => KarbantartasSzerkesztes(k)">Módosítás</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => KarbantartasTorles(k.KarbantartasID)">Törlés</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<TeremDto>? termek;
    private List<KarbantartasDto>? letezoKarbantartasok;
    private UtkozesEredmenyDto? utkozesEredmeny;
    
    private int szerkesztettKarbantartasId = 0;
    private string kivalasztottTeremszam = "";
    private int rogzitendoTeremId = 0;
    private DateTime kezdoIdo = DateTime.Today.AddHours(8);
    private DateTime zaroIdo = DateTime.Today.AddDays(1).AddHours(16);
    private TimeSpan karbantartasHossz = TimeSpan.FromHours(32);
    private string leiras = "";
    
    private bool ellenorzott = false;
    private string hibaUzenet = "";
    private string sikeresUzenet = "";

    private int szerkesztettFoglalasId = 0;
    private string ujTeremszam = "";
    private DateTime ujDatum;
    private TimeOnly ujKezdoId;
    private TimeOnly ujZaroId;
    private TimeSpan eredetiFoglalasIdotartam;

    private int szerkesztettUtkozoKarbId = 0;
    private string ujKarbTeremszam = "";
    private DateTime ujKarbKezdo;
    private DateTime ujKarbZaro;
    private TimeSpan eredetiUtkozoKarbIdotartam;

    protected override async Task OnInitializedAsync()
    {
        if (UserSession.Role != "Adminisztrator")
        {
            Navigation.NavigateTo("/not-found");
            return;
        }

        termek = await Http.GetFromJsonAsync<List<TeremDto>>("api/termek");
        karbantartasHossz = zaroIdo - kezdoIdo;
        await KarbantartasokBetoltese();
    }

    private async Task KarbantartasokBetoltese()
    {
        letezoKarbantartasok = await Http.GetFromJsonAsync<List<KarbantartasDto>>("api/karbantartasiidosav");
    }

    private void KarbantartasKezdoValtozott() { zaroIdo = kezdoIdo.Add(karbantartasHossz); }
    private void KarbantartasZaroValtozott() { if (zaroIdo > kezdoIdo) karbantartasHossz = zaroIdo - kezdoIdo; }

    private async Task Ellenorzes()
    {
        hibaUzenet = ""; sikeresUzenet = "";
        szerkesztettFoglalasId = 0; szerkesztettUtkozoKarbId = 0;

        var valasztottTerem = termek?.FirstOrDefault(t => t.Teremszam.Equals(kivalasztottTeremszam, StringComparison.OrdinalIgnoreCase));
        if (valasztottTerem == null) { hibaUzenet = "Érvénytelen teremszám!"; return; }

        rogzitendoTeremId = valasztottTerem.TeremID;
        if (kezdoIdo >= zaroIdo) { hibaUzenet = "A kezdés nem lehet később, mint a befejezés!"; return; }

        var keres = new
        {
            KarbantartasID = szerkesztettKarbantartasId,
            TeremID = rogzitendoTeremId,
            KezdoIdo = kezdoIdo,
            ZaroIdo = zaroIdo
        };

        var response = await Http.PostAsJsonAsync("api/karbantartasiidosav/utkozesek", keres);
        if (response.IsSuccessStatusCode)
        {
            utkozesEredmeny = await response.Content.ReadFromJsonAsync<UtkozesEredmenyDto>();
            ellenorzott = true;
        }
    }

    private async Task KarbantartasMentes()
    {
        var mentes = new
        {
            KarbantartasID = szerkesztettKarbantartasId,
            TeremID = rogzitendoTeremId,
            KezdoIdo = kezdoIdo,
            ZaroIdo = zaroIdo,
            Leiras = string.IsNullOrWhiteSpace(leiras) ? "Rendszeres karbantartás" : leiras
        };

        HttpResponseMessage response = szerkesztettKarbantartasId > 0 
            ? await Http.PutAsJsonAsync($"api/karbantartasiidosav/{szerkesztettKarbantartasId}", mentes)
            : await Http.PostAsJsonAsync("api/karbantartasiidosav", mentes);
        
        if (response.IsSuccessStatusCode)
        {
            sikeresUzenet = "Karbantartási idősáv sikeresen mentve!";
            MentesMegsem();
            await KarbantartasokBetoltese();
        }
        else { hibaUzenet = await response.Content.ReadAsStringAsync(); }
    }

    private void KarbantartasSzerkesztes(KarbantartasDto dto)
    {
        szerkesztettKarbantartasId = dto.KarbantartasID;
        kivalasztottTeremszam = dto.Teremszam;
        kezdoIdo = dto.KezdoIdo.ToLocalTime();
        zaroIdo = dto.ZaroIdo.ToLocalTime();
        karbantartasHossz = zaroIdo - kezdoIdo;
        leiras = dto.Leiras;
        
        ellenorzott = false; utkozesEredmeny = null; hibaUzenet = ""; sikeresUzenet = "";
    }

    private void MentesMegsem()
    {
        szerkesztettKarbantartasId = 0; kivalasztottTeremszam = ""; leiras = "";
        ellenorzott = false; utkozesEredmeny = null;
    }

    private async Task KarbantartasTorles(int id)
    {
        bool megerositve = await JS.InvokeAsync<bool>("confirm", "Biztosan törölni szeretnéd ezt a karbantartási idősávot?");
        if (megerositve)
        {
            var response = await Http.DeleteAsync($"api/karbantartasiidosav/{id}");
            if (response.IsSuccessStatusCode)
            {
                await KarbantartasokBetoltese();
                if (ellenorzott) await Ellenorzes();
                if (szerkesztettKarbantartasId == id) MentesMegsem();
            }
        }
    }

    private async Task FoglalasTorles(int id)
    {
        bool megerositve = await JS.InvokeAsync<bool>("confirm", "Biztosan törölni szeretnéd ezt a foglalást?");
        if (megerositve)
        {
            var response = await Http.DeleteAsync($"api/foglalasok/{id}");
            if (response.IsSuccessStatusCode) await Ellenorzes(); 
        }
    }

    private void SzerkesztesMegnyitasa(UtkozoFoglalasDto foglalas)
    {
        szerkesztettFoglalasId = foglalas.FoglalasID; ujTeremszam = foglalas.Teremszam;
        var helyiKezdet = foglalas.KezdoIdo.ToLocalTime(); var helyiVeg = foglalas.ZaroIdo.ToLocalTime();
        eredetiFoglalasIdotartam = helyiVeg - helyiKezdet;
        ujDatum = helyiKezdet.Date; ujKezdoId = TimeOnly.FromDateTime(helyiKezdet); ujZaroId = TimeOnly.FromDateTime(helyiVeg);
    }

    private void UjKezdoIdoValtozott() { ujZaroId = ujKezdoId.Add(eredetiFoglalasIdotartam); }

    private async Task FoglalasMentes()
    {
        hibaUzenet = "";
        var ujTerem = termek?.FirstOrDefault(t => t.Teremszam.Equals(ujTeremszam, StringComparison.OrdinalIgnoreCase));
        if (ujTerem == null) { hibaUzenet = "Érvénytelen célterem!"; return; }

        var teljesKezdet = ujDatum.Date.Add(ujKezdoId.ToTimeSpan()); var teljesVeg = ujDatum.Date.Add(ujZaroId.ToTimeSpan());
        if (teljesKezdet >= teljesVeg) { hibaUzenet = "A foglalás vége nem lehet korábban, mint a kezdete!"; return; }

        if (ujTerem.TeremID == rogzitendoTeremId && teljesKezdet < zaroIdo && teljesVeg > kezdoIdo)
        {
            hibaUzenet = "Hiba: Az áthelyezett foglalás továbbra is ütközik a most rögzíteni kívánt karbantartással!"; return;
        }

        var updateDto = new { TeremID = ujTerem.TeremID, OktatoID = 0, KezdoIdo = teljesKezdet, ZaroIdo = teljesVeg };
        var response = await Http.PutAsJsonAsync($"api/foglalasok/{szerkesztettFoglalasId}", updateDto);
        
        if (response.IsSuccessStatusCode) { szerkesztettFoglalasId = 0; await Ellenorzes(); }
        else { hibaUzenet = await response.Content.ReadAsStringAsync(); }
    }

    private void UtkozoKarbSzerkesztesMegnyitasa(UtkozoKarbantartasDto karbantartas)
    {
        szerkesztettUtkozoKarbId = karbantartas.KarbantartasID;
        ujKarbTeremszam = karbantartas.Teremszam;
        var helyiKezdet = karbantartas.KezdoIdo.ToLocalTime();
        var helyiVeg = karbantartas.ZaroIdo.ToLocalTime();
        eredetiUtkozoKarbIdotartam = helyiVeg - helyiKezdet;
        ujKarbKezdo = helyiKezdet;
        ujKarbZaro = helyiVeg;
    }

    private void UjKarbKezdoValtozott() { ujKarbZaro = ujKarbKezdo.Add(eredetiUtkozoKarbIdotartam); }

    private async Task UtkozoKarbantartasMentes(string leirasGombhoz)
    {
        hibaUzenet = "";
        var ujTerem = termek?.FirstOrDefault(t => t.Teremszam.Equals(ujKarbTeremszam, StringComparison.OrdinalIgnoreCase));
        if (ujTerem == null) { hibaUzenet = "Érvénytelen célterem!"; return; }
        if (ujKarbKezdo >= ujKarbZaro) { hibaUzenet = "A kezdés nem lehet később, mint a befejezés!"; return; }

        if (ujTerem.TeremID == rogzitendoTeremId && ujKarbKezdo < zaroIdo && ujKarbZaro > kezdoIdo)
        {
            hibaUzenet = "Hiba: Az áthelyezett karbantartás továbbra is ütközik a most rögzíteni kívánt sávval!"; return;
        }

        var mentesDto = new { 
            TeremID = ujTerem.TeremID, 
            KezdoIdo = ujKarbKezdo, 
            ZaroIdo = ujKarbZaro, 
            Leiras = leirasGombhoz 
        };

        var response = await Http.PutAsJsonAsync($"api/karbantartasiidosav/{szerkesztettUtkozoKarbId}", mentesDto);
        
        if (response.IsSuccessStatusCode)
        {
            szerkesztettUtkozoKarbId = 0;
            await Ellenorzes(); 
            await KarbantartasokBetoltese();
        }
        else { hibaUzenet = await response.Content.ReadAsStringAsync(); }
    }

    public class TeremDto { public int TeremID { get; set; } public string Teremszam { get; set; } = ""; }
    
    public class UtkozesEredmenyDto
    {
        public List<UtkozoFoglalasDto> Foglalasok { get; set; } = new();
        public List<UtkozoKarbantartasDto> Karbantartasok { get; set; } = new();
    }

    public class UtkozoFoglalasDto
    {
        public int FoglalasID { get; set; }
        public string Teremszam { get; set; } = "";
        public string OktatoNev { get; set; } = "";
        public DateTime KezdoIdo { get; set; }
        public DateTime ZaroIdo { get; set; }
    }

    public class UtkozoKarbantartasDto
    {
        public int KarbantartasID { get; set; }
        public string Teremszam { get; set; } = "";
        public DateTime KezdoIdo { get; set; }
        public DateTime ZaroIdo { get; set; }
        public string Leiras { get; set; } = "";
    }

    public class KarbantartasDto
    {
        public int KarbantartasID { get; set; }
        public int TeremID { get; set; }
        public string Teremszam { get; set; } = "";
        public DateTime KezdoIdo { get; set; }
        public DateTime ZaroIdo { get; set; }
        public string Leiras { get; set; } = "";
    }
}