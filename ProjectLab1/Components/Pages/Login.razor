@page "/login"
@inject NavigationManager Navigation
@inject ProjectLab1.Services.UserSessionService UserSession
@inject HttpClient Http
@inject ILogger<Login> Logger

<PageTitle>Bejelentkezés</PageTitle>

<div class="d-flex justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="card shadow p-4" style="width: 100%; max-width: 420px;">
        <h3 class="card-title text-center mb-4 fw-bold text-primary">Egyetemi Kulcs- és Teremnyilvántartó</h3>
        <h5 class="text-center text-muted mb-4">Bejelentkezés</h5>

        <div class="mb-3">
            <label class="form-label fw-bold">Felhasználónév (Email):</label>
            <input type="text" class="form-control" @bind="username" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Jelszó:</label>
            <input type="password" class="form-control" @bind="password" />
        </div>

        <button type="button" class="btn btn-primary w-100 py-2 mt-2 fw-bold" @onclick="HandleLogin" disabled="@isBusy">
            @(isBusy ? "Belépés..." : "Belépés")
        </button>

        @if (!string.IsNullOrEmpty(hibaUzenet))
        {
            <div class="alert alert-danger mt-3 mb-0">@hibaUzenet</div>
        }
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string hibaUzenet = "";
    private bool isBusy;

    private async Task HandleLogin()
    {
        hibaUzenet = "";
        isBusy = true;

        try
        {
            var loginModel = new LoginModel { Username = username, Password = password };
            var response = await Http.PostAsJsonAsync("api/login", loginModel);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResultDto>();
                if (result != null && !string.IsNullOrEmpty(result.Token))
                {
                    // Visszaállítva a stabil szinkron memóriahívásra
                    UserSession.SetUser(result.Id, result.Username, result.Token, result.Role);
                    Navigation.NavigateTo("/");
                    return;
                }

                hibaUzenet = "Hiba történt a válasz feldolgozása során.";
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                hibaUzenet = string.IsNullOrWhiteSpace(errorContent) ? "Hibás felhasználónév vagy jelszó!" : errorContent;
            }
        }
        catch (Exception ex)
        {
            hibaUzenet = $"Hálózati hiba: {ex.Message}";
            Logger.LogError(ex, "Bejelentkezési hiba történt.");
        }
        finally
        {
            isBusy = false;
        }
    }

    public class LoginModel
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }

    public class LoginResultDto
    {
        [System.Text.Json.Serialization.JsonPropertyName("id")]
        public int Id { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("username")]
        public string Username { get; set; } = "";

        [System.Text.Json.Serialization.JsonPropertyName("token")]
        public string Token { get; set; } = "";

        [System.Text.Json.Serialization.JsonPropertyName("role")]
        public string Role { get; set; } = "";
    }
}