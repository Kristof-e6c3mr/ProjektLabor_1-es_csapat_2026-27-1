@page "/login" 
@using ProjectLab1.Auth
@inject HttpClient Http
@inject ILogger<Login> Logger
@inject CustomAuthStateProvider AuthProvider
@inject NavigationManager NavManager

<h3>Login Page</h3>
<EditForm Model="@loginModel" OnValidSubmit="HandleLogin" FormName="loginForm">
    <div style="margin-bottom: 10px;">
        <label>Username:</label>
        <InputText @bind-Value="loginModel.Username" />
    </div>
    
    <div style="margin-bottom: 10px;">
        <label>Password:</label>
        <InputText @bind-Value="loginModel.Password" type="password" />
    </div>
    
    <button type="submit">Log In</button>
</EditForm>

@if (apiResponse != null)
{
    <div style="margin-top: 20px; padding: 15px; border: 1px solid #4CAF50; background-color: #f1f8e9;">
        <h4>Login Successful!</h4>
        <p><strong>Role (Szerepkör):</strong> @apiResponse.Role</p>
        <p><strong>JWT Token:</strong></p>
        <p style="word-break: break-all; font-family: monospace; font-size: 0.9em;">@apiResponse.Token</p>
    </div>
}
else if (loginFailed)
{
    <div style="margin-top: 15px; color: red;">
        Invalid username or password. Please try again.
    </div>
}





@code {

	[SupplyParameterFromForm]
	private LoginModel loginModel { get; set; } = new();

	private LoginResponse? apiResponse;
	private bool loginFailed;

	private async Task HandleLogin()
	{
		loginFailed = false;

		Logger.LogInformation("Login attempt for username: {Username}", loginModel.Username);
		var response = await Http.PostAsJsonAsync("api/login", loginModel);

		apiResponse = null;

		if (response.IsSuccessStatusCode)
		{
			// Deserialize the JSON Payload
			apiResponse = await response.Content.ReadFromJsonAsync<LoginResponse>();

			//if There is a response and the token isnot empty
			if (apiResponse != null && !string.IsNullOrEmpty(apiResponse.Token))
			{
				AuthProvider.MarkUserAsAuthenticated(apiResponse.Token);

				Http.DefaultRequestHeaders.Authorization =
					new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", apiResponse.Token);

				Logger.LogInformation("Login success! Role assigned: {Role}", apiResponse?.Role);

				//redirect to somewhere
				NavManager.NavigateTo("/");
			}
		}
        else
        {
            loginFailed = true;
            Logger.LogWarning("Login failed with status code: {StatusCode}", response.StatusCode);
        }
    }

    public class LoginModel
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }

    public class LoginResponse
    {
        public string Token { get; set; } = "";
        public string Role { get; set; } = "";
    }
}
