@page "/login"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject ProjectLab1.Services.UserSessionService UserSession

<PageTitle>Bejelentkezés</PageTitle>

<div class="d-flex justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="card shadow p-4" style="width: 100%; max-width: 420px;">
        <h3 class="card-title text-center mb-4 fw-bold text-primary">Egyetemi Kulcs- és Teremnyilvántartó</h3>
        <h5 class="text-center text-muted mb-4">Bejelentkezés</h5>

        <div class="mb-3">
            <label class="form-label fw-bold">Felhasználónév (Email):</label>
            <input type="text" class="form-control" @bind="username" @bind:event="oninput" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Jelszó:</label>
            <input type="password" class="form-control" @bind="password" @bind:event="oninput" />
        </div>

        <button type="button" class="btn btn-primary w-100 py-2 mt-2 fw-bold" @onclick="HandleLogin">
            Belépés
        </button>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";

    private void HandleLogin()
    {
        // Közvetlenül a beírt felhasználónevet használjuk, felösleges kényszerített alapérték nélkül
        string cleanUser = username.Trim();
        string lowerUser = cleanUser.ToLower();

        string assignedRole = "Oktato";

        if (lowerUser.Contains("portas") || lowerUser.Contains("porta"))
        {
            assignedRole = "Portas";
        }
        else if (lowerUser.Contains("admin") || lowerUser.Contains("adminisztrator"))
        {
            assignedRole = "Adminisztrator";
        }
        else if (lowerUser.Contains("uzemeltetes") || lowerUser.Contains("igazgato"))
        {
            assignedRole = "UzemeltetesiIgazgato";
        }

        // Elmentjük a pontosan beírt nevet és a felismert szerepkört
        UserSession.SetUser(cleanUser, "dummy-jwt-token", assignedRole);
        Navigation.NavigateTo("/", forceLoad: true);
    }
}