@page "/termek"
@using System.Text.RegularExpressions
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ProjectLab1.Services.UserSessionService UserSession

<PageTitle>Termek kezelése</PageTitle>

<div class="container mt-4">
    <h3>Termek törzsadatai</h3>
    <hr />

    <!-- ÚJ TEREM / MÓDOSÍTÁS ŰRLAP -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header @(szerkesztettTeremId > 0 ? "bg-warning text-dark" : "bg-primary text-white")">
            <h5 class="mb-0">@(szerkesztettTeremId > 0 ? $"Terem szerkesztése: {ujTerem.Teremszam}" : "Új terem felvitele")</h5>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Teremszám</label>
                    <input type="text" class="form-control" placeholder="pl. I102" @bind="ujTerem.Teremszam" disabled="@(szerkesztettTeremId > 0)" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Férőhely</label>
                    <!-- Levettük a disabled attribútumot, így a férőhely szerkeszthető marad módosításkor is -->
                    <input type="number" class="form-control" placeholder="Férőhely" min="0" @bind="ujTerem.Ferohely" />
                </div>
            </div>

            <!-- FELSZERELTSÉGEK CHECKBOX LISTA -->
            <div class="mb-3">
                <label class="form-label fw-bold">Felszereltségek:</label>
                <div class="d-flex flex-wrap gap-3 p-3 border rounded bg-light">
                    @if (elerhetoFelszereltsegek != null)
                    {
                        @foreach (var f in elerhetoFelszereltsegek)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="felszereles_@f.FelszereltsegID"
                                       checked="@kivalasztottFelszereltsegIds.Contains(f.FelszereltsegID)"
                                       @onchange="(e => FelszereltsegValtas(f.FelszereltsegID, e.Value))" />
                                <label class="form-check-label" for="felszereles_@f.FelszereltsegID">
                                    @f.Nev
                                </label>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="d-flex gap-2">
                @if (szerkesztettTeremId == 0)
                {
                    <button class="btn btn-success" @onclick="TeremHozzaadasa">Új terem felvitele</button>
                }
                else
                {
                    <button class="btn btn-warning" @onclick="TeremModositas">Módosítás mentése</button>
                    <button class="btn btn-secondary" @onclick="MentesMegsem">Mégsem</button>
                }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(hibaUzenet))
    {
        <div class="alert alert-danger mb-4">@hibaUzenet</div>
    }

    @if (termek == null)
    {
        <p><em>Betöltés...</em></p>
    }
    else if (!termek.Any())
    {
        <p>Nincsenek rögzített termek.</p>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Teremszám</th>
                    <th>Férőhely</th>
                    <th>Felszereltségek</th>
                    <th>Állapot</th>
                    <th>Műveletek</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var terem in RendezettTermek)
                {
                    <tr>
                        <td>@terem.TeremID</td>
                        <td class="fw-bold">@terem.Teremszam</td>
                        <td>@terem.Ferohely fő</td>
                        <td>
                            @if (terem.Felszereltsegek != null && terem.Felszereltsegek.Any())
                            {
                                @string.Join(", ", terem.Felszereltsegek)
                            }
                            else
                            {
                                <span class="text-muted">Nincs</span>
                            }
                        </td>
                        <td>@(terem.Allapot ? "Aktív" : "Inaktív")</td>
                        <td>
                            <button class="btn btn-warning btn-sm me-2" @onclick="() => SzerkesztesMegnyitasa(terem)">Módosítás</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => TeremTorlese(terem.TeremID, terem.Teremszam)">Törlés</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<TeremDto>? termek;
    private List<FelszereltsegDto>? elerhetoFelszereltsegek;
    private TeremInputDto ujTerem = new() { Allapot = true };
    private List<int> kivalasztottFelszereltsegIds = new();

    private int szerkesztettTeremId = 0;
    private string hibaUzenet = "";

    // Segédfüggvény a természetes sorrendhez
    private string RendezesFormatum(string bemenet)
    {
        if (string.IsNullOrEmpty(bemenet)) return "";
        return Regex.Replace(bemenet, @"\d+", m => m.Value.PadLeft(10, '0'));
    }

    // Termek listájának rendezése: PC0 -> I betűsök -> többi
    private IEnumerable<TeremDto> RendezettTermek
    {
        get
        {
            if (termek == null)
                return Array.Empty<TeremDto>();

            return termek
                .OrderBy(t =>
                {
                    if (t.Teremszam.StartsWith("PC0", StringComparison.OrdinalIgnoreCase)) return 0;
                    if (t.Teremszam.StartsWith("I", StringComparison.OrdinalIgnoreCase)) return 1;
                    return 2;
                })
                .ThenBy(t => RendezesFormatum(t.Teremszam));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AccessGuard.DenyIfMissingRole(UserSession, Navigation, "Adminisztrator")) return;
        await AdatokBetoltese();
    }

    private async Task AdatokBetoltese()
    {
        termek = await HttpAccess.GetJsonAsync<List<TeremDto>>(Http, Navigation, "api/termek");
        elerhetoFelszereltsegek = await HttpAccess.GetJsonAsync<List<FelszereltsegDto>>(Http, Navigation, "api/felszereltseg");
    }

    private void FelszereltsegValtas(int felszereltsegId, object? isChecked)
    {
        if (isChecked is bool checkedValue)
        {
            if (checkedValue && !kivalasztottFelszereltsegIds.Contains(felszereltsegId))
            {
                kivalasztottFelszereltsegIds.Add(felszereltsegId);
            }
            else if (!checkedValue && kivalasztottFelszereltsegIds.Contains(felszereltsegId))
            {
                kivalasztottFelszereltsegIds.Remove(felszereltsegId);
            }
        }
    }

    private async Task TeremHozzaadasa()
    {
        hibaUzenet = "";
        if (string.IsNullOrWhiteSpace(ujTerem.Teremszam)) { hibaUzenet = "A teremszám megadása kötelező!"; return; }

        ujTerem.FelszereltsegIDs = kivalasztottFelszereltsegIds;
        var response = await Http.PostAsJsonAsync("api/termek", ujTerem);
        if (HttpAccess.RedirectIfDenied(response, Navigation)) return;

        if (response.IsSuccessStatusCode)
        {
            MentesMegsem();
            await AdatokBetoltese();
        }
        else { hibaUzenet = await response.Content.ReadAsStringAsync(); }
    }

    private void SzerkesztesMegnyitasa(TeremDto terem)
    {
        szerkesztettTeremId = terem.TeremID;
        ujTerem = new TeremInputDto
        {
            Teremszam = terem.Teremszam,
            Ferohely = terem.Ferohely,
            Allapot = terem.Allapot
        };

        if (elerhetoFelszereltsegek != null)
        {
            kivalasztottFelszereltsegIds = elerhetoFelszereltsegek
                .Where(ef => terem.Felszereltsegek.Contains(ef.Nev))
                .Select(ef => ef.FelszereltsegID)
                .ToList();
        }

        hibaUzenet = "";
    }

    private async Task TeremModositas()
    {
        hibaUzenet = "";
        ujTerem.FelszereltsegIDs = kivalasztottFelszereltsegIds;

        var response = await Http.PutAsJsonAsync($"api/termek/{szerkesztettTeremId}", ujTerem);
        if (HttpAccess.RedirectIfDenied(response, Navigation)) return;

        if (response.IsSuccessStatusCode)
        {
            MentesMegsem();
            await AdatokBetoltese();
        }
        else { hibaUzenet = await response.Content.ReadAsStringAsync(); }
    }

    private void MentesMegsem()
    {
        szerkesztettTeremId = 0;
        ujTerem = new() { Allapot = true };
        kivalasztottFelszereltsegIds.Clear();
        hibaUzenet = "";
    }

    private async Task TeremTorlese(int id, string teremszam)
    {
        hibaUzenet = "";
        bool megerositve = await JS.InvokeAsync<bool>("confirm", $"Biztosan törölni szeretnéd a(z) {teremszam} termet?");
        if (megerositve)
        {
            var response = await Http.DeleteAsync($"api/termek/{id}");
            if (HttpAccess.RedirectIfDenied(response, Navigation)) return;

            if (response.IsSuccessStatusCode)
            {
                await AdatokBetoltese();
            }
            else
            {
                hibaUzenet = await response.Content.ReadAsStringAsync();
            }
        }
    }

    public class TeremDto
    {
        public int TeremID { get; set; }
        public string Teremszam { get; set; } = "";
        public int Ferohely { get; set; }
        public bool Allapot { get; set; }
        public List<string> Felszereltsegek { get; set; } = new();
    }

    public class TeremInputDto
    {
        public string Teremszam { get; set; } = "";
        public int Ferohely { get; set; }
        public bool Allapot { get; set; }
        public List<int> FelszereltsegIDs { get; set; } = new();
    }

    public class FelszereltsegDto
    {
        public int FelszereltsegID { get; set; }
        public string Nev { get; set; } = "";
    }
}