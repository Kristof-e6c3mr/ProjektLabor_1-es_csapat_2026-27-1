@page "/szekreny"
@using System.Text.RegularExpressions
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ProjectLab1.Services.UserSessionService UserSession

<PageTitle>Virtuális Kulcsszekrény</PageTitle>

<style>
    .kulcs-fal {
        background-color: #2c3e50;
        padding: 20px;
        border-radius: 10px;
        border: 4px solid #1a252f;
        box-shadow: inset 0px 10px 20px rgba(0,0,0,0.5);
        display: flex;
        flex-direction: column;
        gap: 15px;
        max-width: 100%;
    }

    .kulcs-polc-cim {
        color: #bdc3c7;
        font-size: 0.85rem;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 2px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        padding-bottom: 3px;
    }

    .kulcs-polc {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .kulcs-akaszto {
        width: 65px;
        height: 65px;
        border-radius: 6px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: white;
        font-weight: bold;
        font-size: 1.1rem;
        cursor: pointer;
        box-shadow: 2px 3px 6px rgba(0,0,0,0.4);
        border: 2px solid rgba(255,255,255,0.25);
        transition: transform 0.15s, filter 0.15s;
        user-select: none;
    }

    .kulcs-akaszto:hover {
        transform: scale(1.1);
        filter: brightness(1.2);
    }

    .statusz-Bent { background-color: #27ae60; }
    .statusz-Kiadva { background-color: #f39c12; }
    .statusz-Késik { background-color: #c0392b; animation: pulseRed 1.5s infinite; }
    .statusz-Közeli-foglalás { background-color: #2980b9; }
    .statusz-Késő-felvétel { background-color: #8e44ad; }

    .kiemelt {
        border: 3px solid #f1c40f !important;
        box-shadow: 0 0 20px #f1c40f !important;
        transform: scale(1.2) !important;
        z-index: 10;
        animation: highlightBlink 0.5s infinite alternate !important;
    }

    @@keyframes highlightBlink {
        from { box-shadow: 0 0 10px #f1c40f; }
        to { box-shadow: 0 0 30px #f1c40f, inset 0 0 15px rgba(255,255,255,0.8); }
    }
    
    @@keyframes pulseRed {
        0% { opacity: 1; }
        50% { opacity: 0.5; }
        100% { opacity: 1; }
    }

    .legend-box {
        width: 16px;
        height: 16px;
        display: inline-block;
        border-radius: 3px;
        margin-right: 6px;
        vertical-align: text-bottom;
    }
</style>

<div class="container-fluid mt-3 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Virtuális Kulcsszekrény</h3>
        <button class="btn btn-outline-secondary btn-sm" @onclick="AdatokBetoltese">
            <span class="bi bi-arrow-clockwise"></span> Frissítés
        </button>
    </div>
    
    <div class="d-flex flex-wrap gap-4 mb-3 p-2 bg-light rounded border small fw-semibold">
        <div><div class="legend-box statusz-Bent"></div> Bent (szabad)</div>
        <div><div class="legend-box statusz-Kiadva"></div> Kiadva</div>
        <div><div class="legend-box statusz-Késik"></div> Késik (lejárt)</div>
        <div><div class="legend-box statusz-Közeli-foglalás"></div> Közeli foglalás (30p)</div>
        <div><div class="legend-box statusz-Késő-felvétel"></div> Késő felvétel</div>
        <div class="text-muted ms-auto fst-italic"><i class="bi bi-info-circle"></i> Kattints egy kulcsra a kiemeléshez!</div>
    </div>

    @if (szekreny == null)
    {
        <p><em>Szekrény betöltése...</em></p>
    }
    else
    {
        <div class="kulcs-fal">
            @foreach (var polc in Polcok)
            {
                <div>
                    <div class="kulcs-polc-cim">@GetPolcNev(polc.Key)</div>
                    <div class="kulcs-polc">
                        @foreach (var kulcs in polc.OrderBy(k => RendezesFormatum(k.Teremszam)))
                        {
                            string rovidNev = kulcs.MesterkulcsE ? $"M{kulcs.KulcsID}" : kulcs.Teremszam;
                            
                            string tooltip = $"{kulcs.Megnevezes} | {kulcs.Statusz}";
                            if (kulcs.Statusz == "Kiadva" || kulcs.Statusz == "Késik")
                            {
                                tooltip += $" ({kulcs.AtvevoNev})";
                            }

                            <div class="kulcs-akaszto statusz-@kulcs.Statusz.Replace(" ", "-") @(villogoKulcsId == kulcs.KulcsID ? "kiemelt" : "")"
                                 title="@tooltip"
                                 @onclick="() => Kiemeles(kulcs.KulcsID)">
                                @rovidNev
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<VirtualisKulcsDto>? szekreny;
    private int villogoKulcsId = 0;

    protected override async Task OnInitializedAsync()
    {
        if (AccessGuard.DenyIfMissingRole(UserSession, Navigation, "Portas", "Adminisztrator")) return;
        await AdatokBetoltese();
    }

    private async Task AdatokBetoltese()
    {
        szekreny = await HttpAccess.GetJsonAsync<List<VirtualisKulcsDto>>(Http, Navigation, "api/kulcsmozgas/virtualis-szekreny");
    }

    private async Task Kiemeles(int kulcsId)
    {
        villogoKulcsId = kulcsId;
        StateHasChanged();

        await Task.Delay(60000);

        if (villogoKulcsId == kulcsId)
        {
            villogoKulcsId = 0;
            StateHasChanged();
        }
    }

    // Csoportosítás szintek szerint a számok alapján (0-99 = Földszint, 100-asok = 1. emelet, stb.)
    private IEnumerable<IGrouping<int, VirtualisKulcsDto>> Polcok
    {
        get
        {
            if (szekreny == null) return Array.Empty<IGrouping<int, VirtualisKulcsDto>>();

            return szekreny
                .GroupBy(k => 
                {
                    if (k.MesterkulcsE) return 99; // Mesterkulcs az alsó sorba kerül
                    
                    // Kinyerjük az első számot a teremnévből (pl. I1 -> 1, I102 -> 102, 210 -> 210)
                    var match = Regex.Match(k.Teremszam, @"\d+");
                    if (match.Success && int.TryParse(match.Value, out int szam))
                    {
                        if (szam < 100) return 0; // Földszint (I1, I2, PC0, stb.)
                        return szam / 100; // 100-asok -> 1, 200-asok -> 2, stb.
                    }
                    return 10; // Egyéb (ha nincs benne szám)
                })
                .OrderBy(g => g.Key);
        }
    }

    private string GetPolcNev(int szint) => szint switch
    {
        0 => "Földszint",
        99 => "Mesterkulcsok",
        10 => "Egyéb",
        _ => $"{szint}. Emelet"
    };

    private string RendezesFormatum(string bemenet)
    {
        if (string.IsNullOrEmpty(bemenet)) return "";
        return Regex.Replace(bemenet, @"\d+", m => m.Value.PadLeft(10, '0'));
    }

    public class VirtualisKulcsDto
    {
        public int KulcsID { get; set; }
        public string Megnevezes { get; set; } = "";
        public string Statusz { get; set; } = "";
        public string AtvevoNev { get; set; } = "";
        public string Teremszam { get; set; } = "";
        public bool MesterkulcsE { get; set; }
    }
}